# ==============================================================================
# MindOS Root Environment Configuration Example
# Copy to .env for local overrides. Do NOT commit actual secrets to Git.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MindOS"

# --- Backend API ---
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=mindos-dev-secret-key-change-in-production-min-32-chars

# --- CORS (comma-separated origins) ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- PostgreSQL Database ---
# MindOS targets PostgreSQL for its data layer.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mindos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mindos

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Future Provider-Agnostic AI Placeholders (Optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
