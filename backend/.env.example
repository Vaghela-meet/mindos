# MindOS Backend Local Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MindOS"

# API Scoping
API_V1_STR="/api/v1"
SECRET_KEY=mindos-dev-secret-key-change-in-production-min-32-chars

# CORS (origins allowed to communicate with backend)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mindos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mindos
